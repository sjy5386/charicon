{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.3.5",
  "default_locale": "en",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["tabs", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*",
        "https://*.github.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://*.github.io/*",
    "https://slack.com/*",
    "https://*.slack.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "charicon-slack@charicon.local",
      "strict_min_version": "109.0"
    }
  }
}
